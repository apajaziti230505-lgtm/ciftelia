{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "rootDir": "src",
    "outDir": "js",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
